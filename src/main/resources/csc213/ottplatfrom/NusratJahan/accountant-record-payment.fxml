<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="csc213.ottplatfrom.NusratJahan.RecordPaymentController"
      spacing="12">
    <padding><Insets top="15" left="20" right="20" bottom="15"/></padding>

    <Label text="Record Subscription Payment" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Subscriber ID:"/>
    <TextField fx:id="subscriberIdField" maxWidth="250"/>

    <Label text="Amount:"/>
    <TextField fx:id="amountField" maxWidth="250"/>

    <Label text="Payment Method:"/>
    <ComboBox fx:id="methodBox" maxWidth="250"/>

    <HBox spacing="10">
        <Button text="Save" onAction="#handleSave"/>
        <Button text="Clear" onAction="#handleClear"/>
        <Button text="Back" onAction="#handleBack"/>
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;"/>
</VBox>