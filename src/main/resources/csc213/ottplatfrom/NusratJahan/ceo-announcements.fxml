<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="440.0" prefWidth="556.0" spacing="12" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.NusratJahan.AnnouncementsController">
    <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Manage Announcements" />

    <Label text="Title:" />
    <TextField fx:id="titleField" maxWidth="400" />

    <Label text="Announcement:" />
    <TextArea fx:id="announcementArea" maxWidth="500" prefRowCount="6" />

    <HBox spacing="10">
        <Button onAction="#handleSave" text="Save" />
        <Button onAction="#handleUpdate" text="Update" />
        <Button onAction="#handleClear" text="Clear" />
        <Button onAction="#handleBack" prefHeight="26.0" prefWidth="94.0" text="Back" />
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;" />
</VBox>
