<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="425.0" prefWidth="312.0" spacing="12" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.NusratJahan.RecordOfflinePaymentController">
    <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Record Offline Payment" />

    <Label text="Subscriber ID:" />
    <TextField fx:id="subscriberIdField" maxWidth="250" />

    <Label text="Amount:" />
    <TextField fx:id="amountField" maxWidth="250" />

    <Label text="Payment Date (YYYY-MM-DD):" />
    <TextField fx:id="dateField" maxWidth="250" />

    <Label text="Payment Method:" />
    <ComboBox fx:id="methodBox" maxWidth="250" />

    <HBox spacing="10">
        <Button onAction="#handleSave" text="Save" />
        <Button onAction="#handleClear" text="Clear" />
        <Button onAction="#handleBack" prefHeight="24.0" prefWidth="96.0" text="Back" />
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;" />
</VBox>
