<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.NusratJahan.RefundRequestsController">
    <top>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Refund Requests">
            <BorderPane.margin><Insets bottom="10" left="15" top="15" /></BorderPane.margin>
        </Label>
    </top>
    <center>
        <TableView fx:id="refundTable">
            <columns>
                <TableColumn fx:id="colRequestId" prefWidth="100" text="Request ID" />
                <TableColumn fx:id="colSubscriberName" prefWidth="160" text="Subscriber Name" />
                <TableColumn fx:id="colAmount" prefWidth="90" text="Amount" />
                <TableColumn fx:id="colReason" prefWidth="220" text="Reason" />
                <TableColumn fx:id="colStatus" prefWidth="90" text="Status" />
            </columns>
            <BorderPane.margin><Insets left="15" right="15" /></BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets bottom="15" right="15" top="10" /></padding>
            <Button onAction="#handleBack" prefHeight="26.0" prefWidth="105.0" text="Back" />
        </HBox>
    </bottom>
</BorderPane>
