<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefWidth="520.0" prefHeight="360.0" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="csc213.ottplatfrom.LoginController">
    <children>
        <Text layoutX="150.0" layoutY="60.0" text="OTT Platform">
            <font>
                <Font size="26.0"/>
            </font>
        </Text>
        <Text layoutX="220.0" layoutY="95.0" text="Sign In">
            <font>
                <Font size="16.0"/>
            </font>
        </Text>

        <Label layoutX="110.0" layoutY="150.0" text="Select User:"/>
        <ComboBox fx:id="userCombo" layoutX="220.0" layoutY="146.0" prefWidth="190.0" promptText="Choose a user"/>

        <Label layoutX="110.0" layoutY="195.0" text="Password:"/>
        <PasswordField fx:id="passwordField" layoutX="220.0" layoutY="191.0" prefWidth="190.0" onAction="#handleSignIn"/>

        <Button layoutX="220.0" layoutY="235.0" text="Sign In" onAction="#handleSignIn"/>

        <Label fx:id="statusLabel" layoutX="110.0" layoutY="280.0" prefWidth="320.0" wrapText="true"/>
    </children>
</AnchorPane>
