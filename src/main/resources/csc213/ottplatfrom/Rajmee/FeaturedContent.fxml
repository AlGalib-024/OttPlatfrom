<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.Rajmee.FeaturedContentController"
            prefHeight="600.0"
            prefWidth="750.0">

    <children>

        <Text layoutX="240.0"
              layoutY="30.0"
              text="Manage Featured Content"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0"
               layoutY="60.0"
               text="Select content to feature on the homepage:"/>

        <TableView fx:id="contentTable"
                   layoutX="30.0"
                   layoutY="85.0"
                   prefWidth="690.0"
                   prefHeight="200.0">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="60.0"/>

                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="200.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="100.0"/>

                <TableColumn fx:id="genreColumn"
                             text="Genre"
                             prefWidth="140.0"/>

                <TableColumn fx:id="featuredColumn"
                             text="Featured"
                             prefWidth="120.0"/>

            </columns>

        </TableView>

        <Label layoutX="30.0"
               layoutY="320.0"
               text="Featured Position:"/>

        <ComboBox fx:id="positionComboBox"
                  layoutX="180.0"
                  layoutY="315.0"
                  prefWidth="180.0"/>

        <Label layoutX="30.0"
               layoutY="370.0"
               text="Promotion Start:"/>

        <DatePicker fx:id="startDatePicker"
                    layoutX="180.0"
                    layoutY="365.0"/>

        <Label layoutX="30.0"
               layoutY="420.0"
               text="Promotion End:"/>

        <DatePicker fx:id="endDatePicker"
                    layoutX="180.0"
                    layoutY="415.0"/>

        <Label fx:id="messageLabel"
               layoutX="30.0"
               layoutY="470.0"/>

        <Button text="Save Featured Content"
                layoutX="30.0"
                layoutY="510.0"
                onAction="#handleSaveFeatured"/>

        <Button text="Remove Featured"
                layoutX="220.0"
                layoutY="510.0"
                onAction="#handleRemoveFeatured"/>

        <Button text="Back"
                layoutX="390.0"
                layoutY="510.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>