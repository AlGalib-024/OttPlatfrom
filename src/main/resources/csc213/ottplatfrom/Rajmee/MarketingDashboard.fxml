<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.Rajmee.MarketingDashboardController"
            prefHeight="500.0"
            prefWidth="700.0">

    <Label layoutX="200.0" layoutY="30.0"
           text="Marketing Manager Dashboard"
           style="-fx-font-size:20px; -fx-font-weight:bold;"/>

    <Button layoutX="220.0" layoutY="80.0"
            prefWidth="250.0"
            text="Create Campaign"
            onAction="#goCreateCampaign"/>

    <Button layoutX="220.0" layoutY="120.0"
            prefWidth="250.0"
            text="Edit Campaign"
            onAction="#goEditCampaign"/>

    <Button layoutX="220.0" layoutY="160.0"
            prefWidth="250.0"
            text="Manage Featured Content"
            onAction="#goFeaturedContent"/>

    <Button layoutX="220.0" layoutY="200.0"
            prefWidth="250.0"
            text="Send Notifications"
            onAction="#goSendNotifications"/>

    <Button layoutX="220.0" layoutY="240.0"
            prefWidth="250.0"
            text="Manage Promotions"
            onAction="#goManagePromotions"/>

    <Button layoutX="220.0" layoutY="280.0"
            prefWidth="250.0"
            text="View Trending Content"
            onAction="#goTrendingContent"/>

    <Button layoutX="220.0" layoutY="320.0"
            prefWidth="250.0"
            text="Campaign Performance Report"
            onAction="#goCampaignPerformance"/>

    <Button layoutX="220.0" layoutY="360.0"
            prefWidth="250.0"
            text="Generate Marketing Report"
            onAction="#goGenerateReport"/>

    <Button layoutX="220.0" layoutY="410.0"
            prefWidth="250.0"
            text="Sign Out"
            style="-fx-text-fill:red;"
            onAction="#goLogout"/>

</AnchorPane>