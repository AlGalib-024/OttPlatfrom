<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.Rajmee.ContentManagerDashboardController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Label layoutX="215.0"
               layoutY="30.0"
               text="Content Manager Dashboard"
               style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Button layoutX="220.0"
                layoutY="80.0"
                prefWidth="250.0"
                text="Add Movie/Series"
                onAction="#goAddContent"/>

        <Button layoutX="220.0"
                layoutY="120.0"
                prefWidth="250.0"
                text="Edit Content Details"
                onAction="#goEditContent"/>

        <Button layoutX="220.0"
                layoutY="160.0"
                prefWidth="250.0"
                text="Delete Content"
                onAction="#goDeleteContent"/>

        <Button layoutX="220.0"
                layoutY="200.0"
                prefWidth="250.0"
                text="Upload Subtitle"
                onAction="#goUploadSubtitle"/>

        <Button layoutX="220.0"
                layoutY="240.0"
                prefWidth="250.0"
                text="Add Episode"
                onAction="#goAddEpisode"/>

        <Button layoutX="220.0"
                layoutY="280.0"
                prefWidth="250.0"
                text="Assign Genre"
                onAction="#goAssignGenre"/>

        <Button layoutX="220.0"
                layoutY="320.0"
                prefWidth="250.0"
                text="Mark Featured Content"
                onAction="#goMarkFeatured"/>

        <Button layoutX="220.0"
                layoutY="360.0"
                prefWidth="250.0"
                text="View Content Analytics"
                onAction="#goContentAnalytics"/>

        <Button layoutX="220.0"
                layoutY="410.0"
                prefWidth="250.0"
                text="Sign Out"
                style="-fx-text-fill:red;"
                onAction="#goLogout"/>

    </children>

</AnchorPane>