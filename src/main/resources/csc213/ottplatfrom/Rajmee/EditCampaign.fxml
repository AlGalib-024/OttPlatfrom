<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.Rajmee.EditCampaignController"
            prefHeight="600.0"
            prefWidth="800.0">

    <children>

        <Text layoutX="300.0" layoutY="30.0"
              text="Edit Campaign"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0" layoutY="60.0"
               text="Select a Campaign"/>

        <TableView fx:id="campaignTable"
                   layoutX="30.0"
                   layoutY="85.0"
                   prefWidth="740.0"
                   prefHeight="150.0">

            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0"/>
                <TableColumn fx:id="nameColumn" text="Campaign Name" prefWidth="300.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="150.0"/>
            </columns>

        </TableView>

        <Label layoutX="30.0"
               layoutY="255.0"
               text="Campaign Name"/>

        <TextField fx:id="campaignNameField"
                   layoutX="170.0"
                   layoutY="250.0"
                   prefWidth="250.0"/>

        <Label layoutX="30.0"
               layoutY="305.0"
               text="Start Date"/>

        <DatePicker fx:id="startDatePicker"
                    layoutX="170.0"
                    layoutY="300.0"/>

        <Label layoutX="30.0"
               layoutY="355.0"
               text="End Date"/>

        <DatePicker fx:id="endDatePicker"
                    layoutX="170.0"
                    layoutY="350.0"/>

        <Label fx:id="messageLabel"
               layoutX="170.0"
               layoutY="400.0"/>

        <Button text="Update Campaign"
                layoutX="170.0"
                layoutY="440.0"
                onAction="#handleUpdateCampaign"/>

        <Button text="Back"
                layoutX="330.0"
                layoutY="440.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>