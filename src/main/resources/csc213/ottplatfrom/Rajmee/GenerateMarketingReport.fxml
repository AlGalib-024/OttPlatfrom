<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.Rajmee.GenerateMarketingReportController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="210.0"
              layoutY="30.0"
              text="Generate Marketing Report"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="40.0"
               layoutY="80.0"
               text="Report Type:"/>

        <ComboBox fx:id="reportTypeComboBox"
                  layoutX="180.0"
                  layoutY="75.0"
                  prefWidth="200.0"/>

        <Label layoutX="40.0"
               layoutY="130.0"
               text="Report Period:"/>

        <ComboBox fx:id="reportPeriodComboBox"
                  layoutX="180.0"
                  layoutY="125.0"
                  prefWidth="200.0"/>

        <Button text="Generate Report"
                layoutX="180.0"
                layoutY="180.0"
                onAction="#handleGenerateReport"/>

        <Text fx:id="reportText"
              layoutX="40.0"
              layoutY="250.0"
              wrappingWidth="600.0"/>

        <Button text="Back"
                layoutX="40.0"
                layoutY="430.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>