<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.Rajmee.CreateCampaignController">

    <Text layoutX="250.0" layoutY="30.0" style="-fx-font-size:20px; -fx-font-weight:bold;" text="Create Marketing Campaign" />

    <Label layoutX="40.0" layoutY="70.0" text="Campaign Name" />
    <TextField fx:id="campaignNameField" layoutX="180.0" layoutY="65.0" prefWidth="220.0" />

    <Label layoutX="40.0" layoutY="120.0" text="Campaign Type" />
    <ComboBox fx:id="campaignTypeComboBox" layoutX="180.0" layoutY="115.0" prefWidth="220.0" />

    <Label layoutX="40.0" layoutY="170.0" text="Start Date" />
    <DatePicker fx:id="startDatePicker" layoutX="180.0" layoutY="165.0" />

    <Label layoutX="40.0" layoutY="220.0" text="End Date" />
    <DatePicker fx:id="endDatePicker" layoutX="180.0" layoutY="215.0" />

    <Label layoutX="40.0" layoutY="270.0" text="Status" />

    <RadioButton fx:id="activeRadioButton" layoutX="180.0" layoutY="265.0" text="Active">
      <toggleGroup>
         <ToggleGroup fx:id="tg" />
      </toggleGroup></RadioButton>

    <RadioButton fx:id="inactiveRadioButton" layoutX="280.0" layoutY="265.0" text="Inactive" toggleGroup="$tg" />

    <Label fx:id="messageLabel" layoutX="180.0" layoutY="315.0" text="" />

    <Button layoutX="180.0" layoutY="350.0" onAction="#handleSaveCampaign" text="Save" />

    <Button layoutX="270.0" layoutY="350.0" onAction="#handleClear" text="Clear" />

    <Button layoutX="360.0" layoutY="350.0" onAction="#handleBack" text="Back" />

    <Text layoutX="40.0" layoutY="420.0" style="-fx-font-size:16px; -fx-font-weight:bold;" text="Campaign List" />

    <TableView fx:id="campaignTable" layoutX="40.0" layoutY="440.0" prefHeight="180.0" prefWidth="700.0">

        <columns>
            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Campaign Name" />
            <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="startColumn" prefWidth="120.0" text="Start Date" />
            <TableColumn fx:id="endColumn" prefWidth="120.0" text="End Date" />
            <TableColumn fx:id="statusColumn" prefWidth="90.0" text="Status" />
        </columns>

    </TableView>

</AnchorPane>
