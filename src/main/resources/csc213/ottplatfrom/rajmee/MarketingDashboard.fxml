<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.MarketingDashboardController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>
        <VBox alignment="TOP_CENTER"
              spacing="10.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>

            <Label text="Marketing Manager Dashboard"
                   style="-fx-font-size:20px; -fx-font-weight:bold;"/>

            <Button text="Create Campaign"
                    maxWidth="Infinity"
                    onAction="#goCreateCampaign"/>

            <Button text="Edit Campaign"
                    maxWidth="Infinity"
                    onAction="#goEditCampaign"/>

            <Button text="Manage Featured Content"
                    maxWidth="Infinity"
                    onAction="#goFeaturedContent"/>

            <Button text="Send Notifications"
                    maxWidth="Infinity"
                    onAction="#goSendNotifications"/>

            <Button text="Manage Promotions"
                    maxWidth="Infinity"
                    onAction="#goManagePromotions"/>

            <Button text="View Trending Content"
                    maxWidth="Infinity"
                    onAction="#goTrendingContent"/>

            <Button text="Campaign Performance Report"
                    maxWidth="Infinity"
                    onAction="#goCampaignPerformance"/>

            <Button text="Generate Marketing Report"
                    maxWidth="Infinity"
                    onAction="#goGenerateReport"/>

            <Button text="Sign Out"
                    style="-fx-text-fill:red;"
                    onAction="#goLogout"/>

        </VBox>
    </children>

</AnchorPane>