<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.UploadSubtitleController"
            prefHeight="550.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="260.0"
              layoutY="30.0"
              text="Upload Subtitle"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0"
               layoutY="60.0"
               text="Select Content:"/>

        <TableView fx:id="contentTable"
                   layoutX="30.0"
                   layoutY="85.0"
                   prefWidth="640.0"
                   prefHeight="180.0">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="80.0"/>

                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="300.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="180.0"/>

            </columns>

        </TableView>

        <Label layoutX="30.0"
               layoutY="290.0"
               text="Subtitle Format:"/>

        <RadioButton fx:id="srtRadio"
                     layoutX="170.0"
                     layoutY="285.0"
                     text="SRT"/>

        <RadioButton fx:id="vttRadio"
                     layoutX="250.0"
                     layoutY="285.0"
                     text="VTT"/>

        <Button text="Choose Subtitle File"
                layoutX="30.0"
                layoutY="340.0"
                onAction="#handleChooseFile"/>

        <Label fx:id="fileNameLabel"
               layoutX="220.0"
               layoutY="345.0"
               text="No file selected"/>

        <Label fx:id="messageLabel"
               layoutX="30.0"
               layoutY="390.0"/>

        <Button text="Upload"
                layoutX="30.0"
                layoutY="430.0"
                onAction="#handleUpload"/>

        <Button text="Back"
                layoutX="140.0"
                layoutY="430.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>