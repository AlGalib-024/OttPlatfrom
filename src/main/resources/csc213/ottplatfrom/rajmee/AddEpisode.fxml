<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.AddEpisodeController"
            prefHeight="550.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="270.0"
              layoutY="30.0"
              text="Add Episode"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0"
               layoutY="70.0"
               text="Series:"/>

        <ComboBox fx:id="seriesComboBox"
                  layoutX="180.0"
                  layoutY="65.0"
                  prefWidth="220.0"/>

        <Label layoutX="30.0"
               layoutY="120.0"
               text="Episode Title:"/>

        <TextField fx:id="episodeTitleField"
                   layoutX="180.0"
                   layoutY="115.0"
                   prefWidth="220.0"/>

        <Label layoutX="30.0"
               layoutY="170.0"
               text="Episode Number:"/>

        <TextField fx:id="episodeNumberField"
                   layoutX="180.0"
                   layoutY="165.0"
                   prefWidth="120.0"
                   promptText="e.g. 5"/>

        <Label layoutX="30.0"
               layoutY="220.0"
               text="Description:"/>

        <TextArea fx:id="descriptionField"
                  layoutX="180.0"
                  layoutY="215.0"
                  prefWidth="300.0"
                  prefHeight="80.0"/>

        <Button text="Choose Video File"
                layoutX="30.0"
                layoutY="320.0"
                onAction="#handleChooseFile"/>

        <Label fx:id="fileNameLabel"
               layoutX="190.0"
               layoutY="325.0"
               text="No file selected"/>

        <Label fx:id="messageLabel"
               layoutX="30.0"
               layoutY="370.0"/>

        <Button text="Save Episode"
                layoutX="30.0"
                layoutY="420.0"
                onAction="#handleSaveEpisode"/>

        <Button text="Back"
                layoutX="170.0"
                layoutY="420.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>