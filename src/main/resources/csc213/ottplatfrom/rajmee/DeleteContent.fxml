<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.DeleteContentController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="270.0"
              layoutY="30.0"
              text="Delete Content"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <TableView fx:id="contentTable"
                   layoutX="30.0"
                   layoutY="60.0"
                   prefWidth="640.0"
                   prefHeight="280.0">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="Content ID"
                             prefWidth="90.0"/>

                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="220.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="150.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="180.0"/>

            </columns>

        </TableView>

        <Label fx:id="messageLabel"
               layoutX="30.0"
               layoutY="360.0"/>

        <Button text="Delete Selected Content"
                layoutX="30.0"
                layoutY="400.0"
                style="-fx-text-fill:red;"
                onAction="#handleDeleteContent"/>

        <Button text="Back"
                layoutX="250.0"
                layoutY="400.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>