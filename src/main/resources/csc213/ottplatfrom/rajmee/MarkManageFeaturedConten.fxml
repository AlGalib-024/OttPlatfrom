<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.MarkFeaturedController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="240.0"
              layoutY="30.0"
              text="Mark Featured Content"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <TableView fx:id="contentTable"
                   layoutX="30.0"
                   layoutY="60.0"
                   prefWidth="640.0"
                   prefHeight="250.0">

            <columns>
                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="60.0"/>

                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="220.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="120.0"/>

                <TableColumn fx:id="featuredColumn"
                             text="Featured"
                             prefWidth="120.0"/>
            </columns>

        </TableView>

        <Label fx:id="messageLabel"
               layoutX="30.0"
               layoutY="330.0"/>

        <Button text="Mark as Featured"
                layoutX="30.0"
                layoutY="370.0"
                onAction="#handleMarkFeatured"/>

        <Button text="Remove Featured"
                layoutX="190.0"
                layoutY="370.0"
                onAction="#handleUnmarkFeatured"/>

        <Button text="Back"
                layoutX="360.0"
                layoutY="370.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>