<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.ManagePromotionController"
            prefHeight="550.0"
            prefWidth="750.0">

    <children>

        <Text layoutX="260.0"
              layoutY="30.0"
              text="Manage Promotions"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="40.0"
               layoutY="70.0"
               text="Promotion Name:"/>

        <TextField fx:id="promotionNameField"
                   layoutX="200.0"
                   layoutY="65.0"
                   prefWidth="250.0"
                   promptText="Max 100 characters"/>

        <Label layoutX="40.0"
               layoutY="120.0"
               text="Promotion Type:"/>

        <RadioButton fx:id="discountRadio"
                     layoutX="200.0"
                     layoutY="115.0"
                     text="Discount"/>

        <RadioButton fx:id="couponRadio"
                     layoutX="310.0"
                     layoutY="115.0"
                     text="Coupon"/>

        <RadioButton fx:id="specialOfferRadio"
                     layoutX="410.0"
                     layoutY="115.0"
                     text="Special Offer"/>

        <Label layoutX="40.0"
               layoutY="170.0"
               text="Discount Percentage:"/>

        <TextField fx:id="discountField"
                   layoutX="200.0"
                   layoutY="165.0"
                   prefWidth="120.0"
                   promptText="20"/>

        <Label layoutX="40.0"
               layoutY="220.0"
               text="Start Date:"/>

        <DatePicker fx:id="startDatePicker"
                    layoutX="200.0"
                    layoutY="215.0"/>

        <Label layoutX="40.0"
               layoutY="270.0"
               text="End Date:"/>

        <DatePicker fx:id="endDatePicker"
                    layoutX="200.0"
                    layoutY="265.0"/>

        <Label layoutX="40.0"
               layoutY="320.0"
               text="Target Audience:"/>

        <ComboBox fx:id="audienceComboBox"
                  layoutX="200.0"
                  layoutY="315.0"
                  prefWidth="180.0"/>

        <Label fx:id="messageLabel"
               layoutX="40.0"
               layoutY="370.0"
               prefWidth="500.0"/>

        <Button text="Save Promotion"
                layoutX="200.0"
                layoutY="420.0"
                onAction="#handleSavePromotion"/>

        <Button text="Back"
                layoutX="350.0"
                layoutY="420.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>