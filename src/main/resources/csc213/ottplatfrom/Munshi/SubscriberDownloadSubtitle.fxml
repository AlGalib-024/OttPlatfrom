<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.SubscriberDownloadSubtitleController">

    <children>

        <Label layoutX="300.0"
               layoutY="20.0"
               text="Download Subtitle"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        <Label layoutX="50.0"
               layoutY="80.0"
               text="Movie / Series"/>

        <ComboBox fx:id="contentComboBox"
                  layoutX="210.0"
                  layoutY="75.0"
                  prefWidth="250.0"/>

        <Label layoutX="50.0"
               layoutY="140.0"
               text="Language"/>

        <ComboBox fx:id="languageComboBox"
                  layoutX="210.0"
                  layoutY="135.0"
                  prefWidth="250.0"/>

        <Label layoutX="50.0"
               layoutY="200.0"
               text="Subtitle Format"/>

        <ComboBox fx:id="formatComboBox"
                  layoutX="210.0"
                  layoutY="195.0"
                  prefWidth="250.0"/>

        <CheckBox fx:id="autoDownloadCheckBox"
                  layoutX="210.0"
                  layoutY="255.0"
                  text="Enable Auto Download"/>

        <Label layoutX="560.0"
               layoutY="60.0"
               text="Available Subtitles"
               style="-fx-font-size:16px; -fx-font-weight:bold;"/>

        <TableView fx:id="subtitleTableView"
                   layoutX="500.0"
                   layoutY="90.0"
                   prefHeight="320.0"
                   prefWidth="340.0">

            <columns>

                <TableColumn fx:id="languageColumn"
                             text="Language"
                             prefWidth="110"/>

                <TableColumn fx:id="formatColumn"
                             text="Format"
                             prefWidth="100"/>

                <TableColumn fx:id="sizeColumn"
                             text="Size"
                             prefWidth="130"/>

            </columns>

        </TableView>

        <Button layoutX="180.0"
                layoutY="520.0"
                prefWidth="140.0"
                text="Download"
                onAction="#downloadOnClick"/>

        <Button layoutX="350.0"
                layoutY="520.0"
                prefWidth="100.0"
                text="Clear"
                onAction="#clearOnClick"/>

        <Button layoutX="480.0"
                layoutY="520.0"
                prefWidth="100.0"
                text="Back"
                onAction="#backOnClick"/>

    </children>

</AnchorPane>