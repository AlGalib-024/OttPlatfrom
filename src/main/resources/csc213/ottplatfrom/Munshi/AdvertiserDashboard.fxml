<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.AdvertiserDashboardController">

    <children>

        <Label layoutX="320.0"
               layoutY="30.0"
               text="Advertiser Dashboard"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <Button layoutX="100.0"
                layoutY="120.0"
                prefWidth="250.0"
                text="Create Advertisement"
                onAction="#createAdvertisementOnClick"/>

        <Button layoutX="500.0"
                layoutY="120.0"
                prefWidth="250.0"
                text="Edit Advertisement"
                onAction="#editAdvertisementOnClick"/>

        <Button layoutX="100.0"
                layoutY="200.0"
                prefWidth="250.0"
                text="Delete Advertisement"
                onAction="#deleteAdvertisementOnClick"/>

        <Button layoutX="500.0"
                layoutY="200.0"
                prefWidth="250.0"
                text="View Advertisement Performance"
                onAction="#viewPerformanceOnClick"/>

        <Button layoutX="100.0"
                layoutY="280.0"
                prefWidth="250.0"
                text="Manage Budget"
                onAction="#manageBudgetOnClick"/>

        <Button layoutX="500.0"
                layoutY="280.0"
                prefWidth="250.0"
                text="Payment History"
                onAction="#paymentHistoryOnClick"/>

        <Button layoutX="100.0"
                layoutY="360.0"
                prefWidth="250.0"
                text="Generate Report"
                onAction="#generateReportOnClick"/>

        <Button layoutX="500.0"
                layoutY="360.0"
                prefWidth="250.0"
                text="Update Profile"
                onAction="#updateProfileOnClick"/>

    </children>

</AnchorPane>