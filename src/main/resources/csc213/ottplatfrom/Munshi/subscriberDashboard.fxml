<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.Munshi.SubscriberDashboardController">

    <children>

        <Label layoutX="310.0" layoutY="30.0" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Subscriber Dashboard" />

        <Button layoutX="120.0" layoutY="120.0" onAction="#buySubscriptionOnClick" prefWidth="250.0" text="Buy Subscription" />

        <Button layoutX="520.0" layoutY="120.0" onAction="#renewSubscriptionOnClick" prefWidth="250.0" text="Renew Subscription" />

        <Button layoutX="120.0" layoutY="200.0" onAction="#viewCurrentPlanOnClick" prefWidth="250.0" text="View Current Plan" />

        <Button layoutX="520.0" layoutY="200.0" onAction="#cancelSubscriptionOnClick" prefWidth="250.0" text="Cancel Subscription" />

        <Button layoutX="120.0" layoutY="280.0" onAction="#updateProfileOnClick" prefWidth="250.0" text="Update Profile" />

        <Button layoutX="520.0" layoutY="280.0" onAction="#changePasswordOnClick" prefWidth="250.0" text="Change Password" />

        <Button layoutX="120.0" layoutY="360.0" onAction="#paymentHistoryOnClick" prefWidth="250.0" text="Payment History" />

        <Button layoutX="520.0" layoutY="360.0" onAction="#downloadSubtitleOnClick" prefWidth="250.0" text="Download Subtitle" />

    </children>

</AnchorPane>
