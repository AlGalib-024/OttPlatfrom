<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.SubscriberRenewSubscriptionController">

    <children>

        <Label layoutX="315.0"
               layoutY="20.0"
               text="Renew Subscription"
               style="-fx-font-size:22px; -fx-font-weight:bold;" />

        <Label layoutX="60.0"
               layoutY="80.0"
               text="Current Plan"/>

        <TextField fx:id="currentPlanTextField"
                   layoutX="220.0"
                   layoutY="75.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="60.0"
               layoutY="130.0"
               text="Expiry Date"/>

        <DatePicker fx:id="expiryDatePicker"
                    layoutX="220.0"
                    layoutY="125.0"
                    disable="true"/>

        <Label layoutX="60.0"
               layoutY="180.0"
               text="Renew Plan"/>

        <ComboBox fx:id="renewPlanComboBox"
                  layoutX="220.0"
                  layoutY="175.0"
                  prefWidth="220.0"/>

        <Label layoutX="60.0"
               layoutY="230.0"
               text="Renew Duration"/>

        <ComboBox fx:id="durationComboBox"
                  layoutX="220.0"
                  layoutY="225.0"
                  prefWidth="220.0"/>

        <Label layoutX="60.0"
               layoutY="280.0"
               text="Payment Method"/>

        <ComboBox fx:id="paymentMethodComboBox"
                  layoutX="220.0"
                  layoutY="275.0"
                  prefWidth="220.0"/>

        <Label layoutX="60.0"
               layoutY="330.0"
               text="Payment Number"/>

        <TextField fx:id="paymentNumberTextField"
                   layoutX="220.0"
                   layoutY="325.0"
                   prefWidth="250.0"/>

        <CheckBox fx:id="autoRenewCheckBox"
                  layoutX="220.0"
                  layoutY="380.0"
                  text="Enable Auto Renewal"/>

        <Label layoutX="560.0"
               layoutY="60.0"
               text="Renewal History"
               style="-fx-font-size:16px; -fx-font-weight:bold;"/>

        <TableView fx:id="renewHistoryTableView"
                   layoutX="500.0"
                   layoutY="90.0"
                   prefHeight="300.0"
                   prefWidth="340.0">

            <columns>

                <TableColumn fx:id="dateColumn"
                             text="Date"
                             prefWidth="110"/>

                <TableColumn fx:id="planColumn"
                             text="Plan"
                             prefWidth="110"/>

                <TableColumn fx:id="amountColumn"
                             text="Amount"
                             prefWidth="120"/>

            </columns>

        </TableView>

        <Button layoutX="180.0"
                layoutY="520.0"
                prefWidth="150.0"
                text="Renew"
                onAction="#renewOnClick"/>

        <Button layoutX="360.0"
                layoutY="520.0"
                prefWidth="120.0"
                text="Clear"
                onAction="#clearOnClick"/>

        <Button layoutX="510.0"
                layoutY="520.0"
                prefWidth="120.0"
                text="Back"
                onAction="#backOnClick"/>

    </children>

</AnchorPane>
