<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.SubscriberBuySubscriptionController">

    <children>

        <Label layoutX="320.0"
               layoutY="20.0"
               style="-fx-font-size:22px; -fx-font-weight:bold;"
               text="Buy Subscription"/>

        <Label layoutX="40.0"
               layoutY="70.0"
               text="Available Subscription Plans"/>

        <TableView fx:id="planTableView"
                   layoutX="40.0"
                   layoutY="100.0"
                   prefHeight="220.0"
                   prefWidth="820.0">

            <columns>

                <TableColumn fx:id="planIdColumn"
                             text="Plan ID"
                             prefWidth="100"/>

                <TableColumn fx:id="planNameColumn"
                             text="Plan Name"
                             prefWidth="200"/>

                <TableColumn fx:id="priceColumn"
                             text="Price"
                             prefWidth="120"/>

                <TableColumn fx:id="durationColumn"
                             text="Duration"
                             prefWidth="150"/>

                <TableColumn fx:id="qualityColumn"
                             text="Quality"
                             prefWidth="250"/>

            </columns>

        </TableView>

        <Label layoutX="70.0"
               layoutY="360.0"
               text="Subscription Plan"/>

        <ComboBox fx:id="planComboBox"
                  layoutX="240.0"
                  layoutY="355.0"
                  prefWidth="250"/>

        <Label layoutX="70.0"
               layoutY="410.0"
               text="Payment Method"/>

        <ComboBox fx:id="paymentMethodComboBox"
                  layoutX="240.0"
                  layoutY="405.0"
                  prefWidth="250"/>

        <Label layoutX="70.0"
               layoutY="460.0"
               text="Payment Number"/>

        <TextField fx:id="paymentNumberTextField"
                   layoutX="240.0"
                   layoutY="455.0"
                   prefWidth="250"
                   promptText="Bkash/Nagad/Card"/>

        <Label layoutX="70.0"
               layoutY="510.0"
               text="Coupon Code"/>

        <TextField fx:id="couponCodeTextField"
                   layoutX="240.0"
                   layoutY="505.0"
                   prefWidth="250"
                   promptText="Optional"/>

        <CheckBox fx:id="agreeTermsCheckBox"
                  layoutX="240.0"
                  layoutY="550.0"
                  text="I agree with Terms &amp; Conditions"/>

        <Button layoutX="180.0"
                layoutY="595.0"
                prefWidth="140.0"
                text="Buy Subscription"
                onAction="#buySubscriptionOnClick"/>

        <Button layoutX="360.0"
                layoutY="595.0"
                prefWidth="120.0"
                text="Clear"
                onAction="#clearOnClick"/>

        <Button layoutX="520.0"
                layoutY="595.0"
                prefWidth="120.0"
                text="Back"
                onAction="#backOnClick"/>

    </children>

</AnchorPane>