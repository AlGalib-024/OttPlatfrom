<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.SubscriberCancelSubscriptionController">

    <children>

        <Label layoutX="300.0"
               layoutY="20.0"
               text="Cancel Subscription"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        <Label layoutX="50.0"
               layoutY="80.0"
               text="Current Plan"/>

        <TextField fx:id="currentPlanTextField"
                   layoutX="220.0"
                   layoutY="75.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="50.0"
               layoutY="130.0"
               text="Subscription Status"/>

        <TextField fx:id="statusTextField"
                   layoutX="220.0"
                   layoutY="125.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="50.0"
               layoutY="180.0"
               text="Expiry Date"/>

        <DatePicker fx:id="expiryDatePicker"
                    layoutX="220.0"
                    layoutY="175.0"
                    disable="true"/>

        <Label layoutX="50.0"
               layoutY="240.0"
               text="Cancellation Reason"/>

        <ComboBox fx:id="reasonComboBox"
                  layoutX="220.0"
                  layoutY="235.0"
                  prefWidth="250.0"/>

        <Label layoutX="50.0"
               layoutY="300.0"
               text="Comments"/>

        <TextArea fx:id="commentsTextArea"
                  layoutX="220.0"
                  layoutY="295.0"
                  prefWidth="320.0"
                  prefHeight="120.0"/>

        <CheckBox fx:id="confirmCheckBox"
                  layoutX="220.0"
                  layoutY="440.0"
                  text="I confirm that I want to cancel my subscription."/>

        <Label layoutX="640.0"
               layoutY="70.0"
               text="Subscription Summary"
               style="-fx-font-size:16px; -fx-font-weight:bold;"/>

        <TableView fx:id="summaryTableView"
                   layoutX="560.0"
                   layoutY="100.0"
                   prefHeight="320.0"
                   prefWidth="300.0">

            <columns>

                <TableColumn fx:id="fieldColumn"
                             text="Field"
                             prefWidth="150"/>

                <TableColumn fx:id="valueColumn"
                             text="Value"
                             prefWidth="150"/>

            </columns>

        </TableView>

        <Button layoutX="180.0"
                layoutY="540.0"
                prefWidth="180.0"
                text="Confirm Cancellation"
                onAction="#confirmCancellationOnClick"/>

        <Button layoutX="390.0"
                layoutY="540.0"
                prefWidth="100.0"
                text="Clear"
                onAction="#clearOnClick"/>

        <Button layoutX="520.0"
                layoutY="540.0"
                prefWidth="100.0"
                text="Back"
                onAction="#backOnClick"/>

    </children>

</AnchorPane>