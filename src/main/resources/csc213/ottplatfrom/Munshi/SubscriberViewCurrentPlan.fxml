<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="csc213.ottplatfrom.Munshi.SubscriberViewCurrentPlanController">

    <children>

        <Label layoutX="300.0"
               layoutY="20.0"
               text="Current Subscription Plan"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        <Label layoutX="60.0"
               layoutY="80.0"
               text="Subscriber ID"/>

        <TextField fx:id="subscriberIdTextField"
                   layoutX="220.0"
                   layoutY="75.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="60.0"
               layoutY="130.0"
               text="Subscriber Name"/>

        <TextField fx:id="subscriberNameTextField"
                   layoutX="220.0"
                   layoutY="125.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="60.0"
               layoutY="180.0"
               text="Current Plan"/>

        <TextField fx:id="currentPlanTextField"
                   layoutX="220.0"
                   layoutY="175.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="60.0"
               layoutY="230.0"
               text="Status"/>

        <TextField fx:id="statusTextField"
                   layoutX="220.0"
                   layoutY="225.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="60.0"
               layoutY="280.0"
               text="Start Date"/>

        <DatePicker fx:id="startDatePicker"
                    layoutX="220.0"
                    layoutY="275.0"
                    disable="true"/>

        <Label layoutX="60.0"
               layoutY="330.0"
               text="Expiry Date"/>

        <DatePicker fx:id="expiryDatePicker"
                    layoutX="220.0"
                    layoutY="325.0"
                    disable="true"/>

        <Label layoutX="60.0"
               layoutY="380.0"
               text="Remaining Days"/>

        <TextField fx:id="remainingDaysTextField"
                   layoutX="220.0"
                   layoutY="375.0"
                   prefWidth="220.0"
                   editable="false"/>

        <Label layoutX="560.0"
               layoutY="60.0"
               text="Plan Features"
               style="-fx-font-size:16px; -fx-font-weight:bold;"/>

        <TableView fx:id="featureTableView"
                   layoutX="500.0"
                   layoutY="90.0"
                   prefHeight="320.0"
                   prefWidth="340.0">

            <columns>

                <TableColumn fx:id="featureColumn"
                             text="Feature"
                             prefWidth="170"/>

                <TableColumn fx:id="valueColumn"
                             text="Value"
                             prefWidth="170"/>

            </columns>

        </TableView>

        <Button layoutX="170.0"
                layoutY="540.0"
                prefWidth="120.0"
                text="Refresh"
                onAction="#refreshOnClick"/>

        <Button layoutX="340.0"
                layoutY="540.0"
                prefWidth="150.0"
                text="Renew Plan"
                onAction="#renewPlanOnClick"/>

        <Button layoutX="540.0"
                layoutY="540.0"
                prefWidth="120.0"
                text="Back"
                onAction="#backOnClick"/>

    </children>

</AnchorPane>
