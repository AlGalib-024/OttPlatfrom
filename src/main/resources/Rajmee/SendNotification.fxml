<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.SendNotificationController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="240.0"
              layoutY="30.0"
              text="Send Notifications"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="40.0"
               layoutY="70.0"
               text="Notification Title:"/>

        <TextField fx:id="titleField"
                   layoutX="190.0"
                   layoutY="65.0"
                   prefWidth="300.0"
                   promptText="Max 100 characters"/>

        <Label layoutX="40.0"
               layoutY="120.0"
               text="Notification Message:"/>

        <TextArea fx:id="messageField"
                  layoutX="190.0"
                  layoutY="115.0"
                  prefWidth="300.0"
                  prefHeight="80.0"
                  promptText="Max 500 characters"/>

        <Label layoutX="40.0"
               layoutY="220.0"
               text="Notification Type:"/>

        <ComboBox fx:id="typeComboBox"
                  layoutX="190.0"
                  layoutY="215.0"
                  prefWidth="200.0"/>

        <Label layoutX="40.0"
               layoutY="270.0"
               text="Target Audience:"/>

        <ComboBox fx:id="audienceComboBox"
                  layoutX="190.0"
                  layoutY="265.0"
                  prefWidth="200.0"/>

        <Label fx:id="resultLabel"
               layoutX="40.0"
               layoutY="320.0"
               prefWidth="500.0"
               wrapText="true"/>

        <Button text="Preview Notification"
                layoutX="40.0"
                layoutY="370.0"
                onAction="#handlePreview"/>

        <Button text="Send Notification"
                layoutX="220.0"
                layoutY="370.0"
                onAction="#handleSend"/>

        <Button text="Back"
                layoutX="380.0"
                layoutY="370.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>