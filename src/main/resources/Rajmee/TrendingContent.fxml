<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.TrendingContentController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>

        <Text layoutX="240.0"
              layoutY="30.0"
              text="View Trending Content"
              style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label layoutX="40.0"
               layoutY="70.0"
               text="Analysis Period:"/>

        <ComboBox fx:id="periodComboBox"
                  layoutX="170.0"
                  layoutY="65.0"
                  prefWidth="180.0"/>

        <Button text="Generate Report"
                layoutX="380.0"
                layoutY="65.0"
                onAction="#handleGenerateReport"/>

        <Text fx:id="reportTitleText"
              layoutX="40.0"
              layoutY="120.0"
              style="-fx-font-size:16px; -fx-font-weight:bold;"/>

        <TableView fx:id="trendingTable"
                   layoutX="40.0"
                   layoutY="140.0"
                   prefWidth="620.0"
                   prefHeight="250.0">

            <columns>

                <TableColumn fx:id="rankColumn"
                             text="Rank"
                             prefWidth="80.0"/>

                <TableColumn fx:id="titleColumn"
                             text="Content Title"
                             prefWidth="240.0"/>

                <TableColumn fx:id="viewsColumn"
                             text="Total Views"
                             prefWidth="150.0"/>

                <TableColumn fx:id="ratingColumn"
                             text="Average Rating"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

        <Button text="Back"
                layoutX="40.0"
                layoutY="420.0"
                onAction="#handleBack"/>

    </children>

</AnchorPane>