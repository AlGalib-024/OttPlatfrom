<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" styleClass="tg" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc213.ottplatfrom.rajmee.ManagePromotionController">

    <children>

        <Text layoutX="260.0" layoutY="30.0" style="-fx-font-size:20px; -fx-font-weight:bold;" text="Manage Promotions" />

        <Label layoutX="40.0" layoutY="70.0" text="Promotion Name:" />

        <TextField fx:id="promotionNameField" layoutX="200.0" layoutY="65.0" prefWidth="250.0" promptText="Max 100 characters" />

        <Label layoutX="40.0" layoutY="120.0" text="Promotion Type:" />

        <RadioButton fx:id="discountRadio" layoutX="200.0" layoutY="115.0" text="Discount">
         <toggleGroup>
            <ToggleGroup fx:id="tg" />
         </toggleGroup></RadioButton>

        <RadioButton fx:id="couponRadio" layoutX="310.0" layoutY="115.0" text="Coupon" toggleGroup="$tg" />

        <RadioButton fx:id="specialOfferRadio" layoutX="410.0" layoutY="115.0" text="Special Offer" toggleGroup="$tg" />

        <Label layoutX="40.0" layoutY="170.0" text="Discount Percentage:" />

        <TextField fx:id="discountField" layoutX="200.0" layoutY="165.0" prefWidth="120.0" promptText="20" />

        <Label layoutX="40.0" layoutY="220.0" text="Start Date:" />

        <DatePicker fx:id="startDatePicker" layoutX="200.0" layoutY="215.0" />

        <Label layoutX="40.0" layoutY="270.0" text="End Date:" />

        <DatePicker fx:id="endDatePicker" layoutX="200.0" layoutY="265.0" />

        <Label layoutX="40.0" layoutY="320.0" text="Target Audience:" />

        <ComboBox fx:id="audienceComboBox" layoutX="200.0" layoutY="315.0" prefWidth="180.0" />

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="370.0" prefWidth="500.0" />

        <Button layoutX="200.0" layoutY="420.0" onAction="#handleSavePromotion" text="Save Promotion" />

        <Button layoutX="350.0" layoutY="420.0" onAction="#handleBack" text="Back" />

    </children>

</AnchorPane>
