<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="csc213.ottplatfrom.rajmee.AddContentController"
            prefHeight="500.0"
            prefWidth="700.0">

    <children>
        <VBox spacing="12.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="Add Movie / Series"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <GridPane hgap="10.0" vgap="10.0">

                <Label text="Content Title:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="titleField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Content Type:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="typeComboBox"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Description:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextArea fx:id="descriptionField"
                          prefRowCount="3"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Release Date:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <DatePicker fx:id="releaseDatePicker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                <Label text="Genre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <ComboBox fx:id="genreComboBox"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>

            </GridPane>

            <Label fx:id="messageLabel"
                   style="-fx-text-fill:green;"/>

            <HBox spacing="10.0">

                <Button text="Save Content"
                        onAction="#handleSaveContent"/>

                <Button text="Back"
                        onAction="#handleBack"/>

            </HBox>

        </VBox>
    </children>

</AnchorPane>